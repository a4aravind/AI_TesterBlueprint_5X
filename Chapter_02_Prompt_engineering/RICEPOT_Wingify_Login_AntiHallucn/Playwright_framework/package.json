{
  "name": "wingify-login-playwright",
  "private": true,
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:headed:valid": "playwright test --headed tests/valid-login.spec.ts",
    "test:headed:invalid": "playwright test --headed tests/invalid-login.spec.ts",
    "report": "playwright show-report",
    "allure:generate": "allure generate allure-results --clean -o allure-report",
    "allure:open": "allure open allure-report",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.11",
    "allure-commandline": "^2.46.2",
    "allure-playwright": "^3.15.0",
    "dotenv": "^18.0.10",
    "typescript": "^7.0.2"
  }
}
